{
  "name": "opencode-jarvis-voice",
  "version": "1.5.4",
  "private": false,
  "type": "module",
  "description": "Local voice for OpenCode by default: push-to-talk, read-aloud with pause/resume, Whisper ears and a Piper voice. Optional Fish Audio cloud voices and speech-to-text.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iflyabd/opencode-jarvis-voice.git"
  },
  "homepage": "https://github.com/iflyabd/opencode-jarvis-voice#readme",
  "bugs": {
    "url": "https://github.com/iflyabd/opencode-jarvis-voice/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "voice",
    "push-to-talk",
    "speech-to-text",
    "text-to-speech",
    "whisper",
    "piper",
    "jarvis",
    "local",
    "offline",
    "fish-audio"
  ],
  "exports": {
    ".": "./plugin/index.ts",
    "./tui": "./plugin/tui.tsx"
  },
  "files": [
    "plugin",
    "daemon",
    "bin",
    "requirements.txt",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "cd plugin && npx tsc --noEmit",
    "test:ui": "cd plugin && bun test/ui.check.ts",
    "test:flow": "cd plugin && bun test/flow.check.ts",
    "test:layout": "cd plugin && bun test/layout.check.tsx",
    "test:daemon": ".venv/bin/python daemon/test_turns.py",
    "test": "npm run check && npm run test:ui && npm run test:flow && npm run test:layout && npm run test:daemon"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": "^1.9.0"
  }
}
